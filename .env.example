# ==============================================================================
# ReviewPulse — Environment Configuration
# ==============================================================================
# This file contains INFRASTRUCTURE configuration only.
# Restaurant-specific content goes in config.json, NOT here.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Optional - Reviews/Database if used)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ------------------------------------------------------------------------------
# Firebase Configuration (Client-Safe)
# ------------------------------------------------------------------------------
# These are safe to expose to the browser. Firebase API keys are not secrets.
# Get these from: Firebase Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ------------------------------------------------------------------------------
# Firebase Admin (Server-Side Secret)
# ------------------------------------------------------------------------------
# NEVER expose this to the browser. This is a service account private key.
# Get this from: Firebase Console -> Project Settings -> Service Accounts
# Generate a new private key and paste the JSON content (or base64 encode it).
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
APP_DOMAIN=https://biriyani-badshah.vercel.app/
NEXT_PUBLIC_APP_URL=https://biriyani-badshah.vercel.app/

# ------------------------------------------------------------------------------
# Session Cookie (Minimum 32 random characters)
# ------------------------------------------------------------------------------
SESSION_COOKIE_SECRET=generate-a-random-32-char-string-here-32chars

# ------------------------------------------------------------------------------
# Security (Minimum 32 random characters)
# ------------------------------------------------------------------------------
HASH_SALT=generate-another-random-32-char-string-32ch

# ------------------------------------------------------------------------------
# Optional: Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ------------------------------------------------------------------------------
# LLM Review Drafting (Groq API Key — OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# This is a SERVER-SIDE secret. Never expose to the browser.
# Get this from: https://console.groq.com/keys
# A Groq key stored in ANTHROPIC_API_KEY (gsk_ prefix) is also accepted.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
