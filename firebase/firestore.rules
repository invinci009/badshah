rules_version = '2';
// ==============================================================================
// ReviewPulse — Firestore Security Rules
// ==============================================================================
// Single-restaurant deployment model: each Firebase project serves one restaurant.
// No multi-tenant complexity. Public access is minimal and controlled.
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================================
    // Restaurant Settings
    // ==============================================================================
    // Public can read minimal settings needed for customer-facing pages.
    // Only authenticated admins can write.
    // ==============================================================================
    match /restaurant/{document} {
      allow read: if true; // Public read for customer branding
      allow write: if request.auth != null;
    }

    // ==============================================================================
    // Campaigns
    // ==============================================================================
    // Public can read active campaigns (needed for QR landing pages).
    // Only authenticated admins can write.
    // ==============================================================================
    match /campaigns/{campaignId} {
      allow read: if true; // Public read for customer flow
      allow write: if request.auth != null;
    }

    // ==============================================================================
    // Menu Items
    // ==============================================================================
    // Public can read active menu items (needed for "ordered" question).
    // Only authenticated admins can write.
    // ==============================================================================
    match /menuItems/{itemId} {
      allow read: if true; // Public read for customer flow
      allow write: if request.auth != null;
    }

    // ==============================================================================
    // Questions
    // ==============================================================================
    // Public can read active questions (needed for quiz).
    // Only authenticated admins can write.
    // ==============================================================================
    match /questions/{questionId} {
      allow read: if true; // Public read for customer flow
      allow write: if request.auth != null;
    }

    // ==============================================================================
    // Sessions
    // ==============================================================================
    // Public can create sessions (customer starts quiz).
    // Public can read their own session (via session ID in cookie).
    // Only authenticated admins can read all sessions.
    // ==============================================================================
    match /sessions/{sessionId} {
      allow create: if true; // Public can create sessions
      allow read: if request.auth != null; // Admin read all
      allow update: if request.auth != null; // Admin update
      allow delete: if false; // Never delete sessions
    }

    // ==============================================================================
    // Answers
    // ==============================================================================
    // Public can create answers (customer submits quiz answers).
    // Only authenticated admins can read.
    // ==============================================================================
    match /answers/{answerId} {
      allow create: if true; // Public can submit answers
      allow read: if request.auth != null; // Admin read
      allow update: if false;
      allow delete: if false;
    }

    // ==============================================================================
    // Review Drafts
    // ==============================================================================
    // Public can create/update drafts (customer edits their draft).
    // Only authenticated admins can read.
    // ==============================================================================
    match /reviewDrafts/{draftId} {
      allow create: if true; // Public can create drafts
      allow read: if request.auth != null; // Admin read
      allow update: if true; // Public can update their own draft
      allow delete: if false;
    }

    // ==============================================================================
    // Private Feedback
    // ==============================================================================
    // Public can create private feedback (customer submits feedback).
    // Only authenticated admins can read.
    // ==============================================================================
    match /privateFeedback/{feedbackId} {
      allow create: if true; // Public can submit feedback
      allow read: if request.auth != null; // Admin read
      allow update: if false;
      allow delete: if false;
    }

    // ==============================================================================
    // Events (Analytics)
    // ==============================================================================
    // Public can create events (customer analytics tracking).
    // Only authenticated admins can read.
    // ==============================================================================
    match /events/{eventId} {
      allow create: if true; // Public can log events
      allow read: if request.auth != null; // Admin read
      allow update: if false;
      allow delete: if false;
    }

    // ==============================================================================
    // Customers (CRM)
    // ==============================================================================
    // Only authenticated admins can access customer records.
    // ==============================================================================
    match /customers/{customerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ==============================================================================
    // Session Flags
    // ==============================================================================
    // Only authenticated admins can access session flags.
    // ==============================================================================
    match /sessionFlags/{flagId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ==============================================================================
    // Ordering — Dining Tables (admin-only; customers never read directly,
    // table identity is resolved server-side from opaque QR tokens)
    // ==============================================================================
    match /diningTables/{tableId} {
      allow read, write: if request.auth != null;
    }

    // Ordering — Table QR Tokens (admin-only; public resolution happens via
    // server route handlers using the Admin SDK, never direct reads)
    match /tableQrTokens/{tokenHash} {
      allow read, write: if request.auth != null;
    }

    // Ordering — Restaurant ordering config (tax, charges, switches)
    match /restaurant/ordering {
      allow read: if true; // tax rate shown on customer menu
      allow write: if request.auth != null;
    }

    // Ordering — Catalog (public read of visible items via server APIs;
    // direct client reads allowed for menu display, writes admin-only)
    match /orderMenuCategories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orderMenuItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ordering — Orders (admin-only direct access; customers go through
    // server routes with unguessable access tokens)
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /orderEvents/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /paymentEntries/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /serviceRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // ==============================================================================
    // Default Deny
    // ==============================================================================
    // Deny all other access by default.
    // ==============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
